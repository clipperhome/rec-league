// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum GameStatus {
  SCHEDULED
  COMPLETED
  RAINED_OUT
  RESCHEDULED
}

model League {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  sport             String?
  seasonLabel       String?
  commissionerEmail String?
  gameNights        String?
  fieldNames        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  teams          Team[]
  games          Game[]
  magicLinkTokens MagicLinkToken[]

  @@index([commissionerEmail])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  leagueId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email, leagueId])
}

model CommissionerSession {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model Team {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeGames Game[] @relation("HomeTeamGames")
  awayGames Game[] @relation("AwayTeamGames")

  @@unique([leagueId, name])
  @@index([leagueId])
}

model Game {
  id          String     @id @default(cuid())
  leagueId    String
  round       Int
  homeTeamId  String
  awayTeamId  String
  scheduledAt DateTime?
  fieldName   String?
  locked      Boolean    @default(false)
  status      GameStatus @default(SCHEDULED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  league   League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam Team    @relation("HomeTeamGames", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam Team    @relation("AwayTeamGames", fields: [awayTeamId], references: [id], onDelete: Cascade)
  result   Result?

  @@index([leagueId, round])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model Result {
  id          String   @id @default(cuid())
  gameId      String   @unique
  homeScore   Int
  awayScore   Int
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}
