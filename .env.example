# Local development is zero-setup. Leave this unset or use a SQLite file URL.
DATABASE_URL="file:./dev.db"

# Enables the loopback-only role switcher while using local SQLite development.
# Never enables in a production build or with PostgreSQL.
REC_LEAGUE_DEV_PROFILE_SWITCHER="1"

# Production accepts postgres:// and postgresql:// URLs. For example:
# DATABASE_URL="postgresql://user:password@host/rec_league?sslmode=require"
# The URL scheme selects the matching Prisma schema, migrations, and client.
# Production startup fails if this is missing, a file: URL, or another scheme.
# Optional: cap each app instance's PostgreSQL connections (default 3, max 20).
# DATABASE_POOL_MAX=3

# Optional: set to "production" in Vercel (auto-set by Vercel)
# NODE_ENV=production

# Required in production for trusted magic-link redirects and email delivery.
# APP_URL="https://your-domain.example"
# RESEND_API_KEY="re_replace_me"
# AUTH_FROM_EMAIL="Rec League <leagues@your-domain.example>"
